
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #090a0d;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
  min-height: 100vh;
}

header {
  padding: 35px 15px;
  border-bottom: 1px solid #292929;
}

header h1 {
  font-size: 42px;
  letter-spacing: 9px;
}

header p {
  color: #999;
  letter-spacing: 5px;
  font-size: 11px;
  margin-top: 8px;
}

main {
  max-width: 900px;
  margin: auto;
  padding: 50px 20px;
}

h2 {
  margin-bottom: 20px;
  letter-spacing: 2px;
}

p {
  color: #aaa;
  line-height: 1.7;
}

button {
  background: #fff;
  color: #080808;
  border: none;
  padding: 14px 28px;
  margin: 20px 5px;
  cursor: pointer;
  font-weight: bold;
  transition: .2s;
}

button:hover {
  background: #aaa;
  transform: scale(1.04);
}

.hidden {
  display: none;
}

#levelGrid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
  margin-top: 30px;
}

.level {
  background: #17191e;
  color: white;
  border: 1px solid #333;
  padding: 20px 5px;
  margin: 0;
}

.level:disabled {
  opacity: .35;
  cursor: not-allowed;
}

#clues, #answers {
  margin-top: 25px;
}

.clue {
  background: #17191e;
  border: 1px solid #333;
  padding: 15px;
  margin: 10px auto;
  max-width: 500px;
}

#feedback {
  margin-top: 20px;
  font-weight: bold;
}

footer {
  padding: 30px;
  color: #555;
  font-size: 12px;
}

@media(max-width: 500px) {
  #levelGrid {
    grid-template-columns: repeat(3, 1fr);
  }
}
